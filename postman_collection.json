{
  "info": {
    "name": "ROOST Hostel Management API Collection",
    "description": "Production-ready Postman collection for all ROOST Backend APIs covering Auth, Reception (Guests, Bookings, Beds), Finance (Payments, Invoices, Refunds), Management (Staff, Inventory), Experience (Complaints, Feedback), Reports & BI, and System modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "guestId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "propertyId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "roomId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "bedId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "bookingCode",
      "value": "ROOST-EXAMPLE",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "complaintId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "staffId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Profile",
      "item": [
        {
          "name": "1.1 Register Guest / User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Password1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register"
            }
          }
        },
        {
          "name": "1.2 Login (Auto-captures Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"token\", res.data.accessToken);",
                  "    console.log(\"Access token saved:\", res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@roost.com\",\n  \"password\": \"Password1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            }
          }
        },
        {
          "name": "1.3 Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"adminToken\", res.data.accessToken);",
                  "    pm.collectionVariables.set(\"token\", res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@roost.com\",\n  \"password\": \"Password1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/login"
            }
          }
        },
        {
          "name": "1.4 Get Profile (GET /auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me"
            }
          }
        },
        {
          "name": "1.5 Update Profile (PATCH /auth/me)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma (Updated)\",\n  \"phone\": \"9876543211\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me"
            }
          }
        },
        {
          "name": "1.6 Forgot Password (POST /auth/forgot-password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.sharma@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password"
